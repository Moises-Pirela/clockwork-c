get_filename_component(CW_SOKOL "${CMAKE_CURRENT_LIST_DIR}/../third_party/sokol" ABSOLUTE)
set(CW_SOKOL_REQUIRED sokol_app.h sokol_gfx.h sokol_glue.h sokol_log.h util/sokol_gl.h util/sokol_debugtext.h LICENSE)
foreach(CW_SOKOL_FILE IN LISTS CW_SOKOL_REQUIRED)
    if(NOT EXISTS "${CW_SOKOL}/${CW_SOKOL_FILE}")
        message(FATAL_ERROR "Bundled Sokol file missing: ${CW_SOKOL_FILE}. Restore third_party/sokol from the repository.")
    endif()
endforeach()
