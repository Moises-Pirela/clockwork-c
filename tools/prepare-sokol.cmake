file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/sokol.lock" CW_SOKOL_LOCK)
list(GET CW_SOKOL_LOCK 0 CW_SOKOL_URL)
list(GET CW_SOKOL_LOCK 1 CW_SOKOL_HASH)
string(REGEX REPLACE ".*/" "" CW_SOKOL_REVISION "${CW_SOKOL_URL}")
if(NOT DEFINED CW_DEPENDENCY_DIR)
    set(CW_DEPENDENCY_DIR "${CMAKE_CURRENT_BINARY_DIR}/_deps")
endif()
set(CW_SOKOL "${CW_DEPENDENCY_DIR}/sokol-${CW_SOKOL_REVISION}")
set(CW_SOKOL_MARKER "${CW_SOKOL}/.clockwork-ready")
set(CW_SOKOL_REQUIRED sokol_app.h sokol_gfx.h sokol_glue.h sokol_log.h util/sokol_gl.h util/sokol_debugtext.h LICENSE)
set(CW_SOKOL_COMPLETE TRUE)
foreach(CW_SOKOL_FILE IN LISTS CW_SOKOL_REQUIRED)
    if(NOT EXISTS "${CW_SOKOL}/${CW_SOKOL_FILE}")
        set(CW_SOKOL_COMPLETE FALSE)
    endif()
endforeach()
if(CW_SOKOL_COMPLETE AND EXISTS "${CW_SOKOL_MARKER}")
    file(READ "${CW_SOKOL_MARKER}" CW_SOKOL_READY)
    string(STRIP "${CW_SOKOL_READY}" CW_SOKOL_READY)
    if(CW_SOKOL_READY STREQUAL CW_SOKOL_HASH)
        return()
    endif()
endif()
file(MAKE_DIRECTORY "${CW_DEPENDENCY_DIR}")
set(CW_SOKOL_ARCHIVE "${CW_DEPENDENCY_DIR}/sokol-${CW_SOKOL_REVISION}.zip")
if(NOT EXISTS "${CW_SOKOL_ARCHIVE}")
    file(DOWNLOAD "${CW_SOKOL_URL}" "${CW_SOKOL_ARCHIVE}.download"
        EXPECTED_HASH "SHA256=${CW_SOKOL_HASH}" TLS_VERIFY ON STATUS CW_SOKOL_DOWNLOAD_STATUS)
    list(GET CW_SOKOL_DOWNLOAD_STATUS 0 CW_SOKOL_DOWNLOAD_CODE)
    if(NOT CW_SOKOL_DOWNLOAD_CODE EQUAL 0)
        message(FATAL_ERROR "Sokol dependency download failed: ${CW_SOKOL_DOWNLOAD_STATUS}")
    endif()
    file(RENAME "${CW_SOKOL_ARCHIVE}.download" "${CW_SOKOL_ARCHIVE}")
endif()
file(SHA256 "${CW_SOKOL_ARCHIVE}" CW_SOKOL_ACTUAL_HASH)
if(NOT CW_SOKOL_ACTUAL_HASH STREQUAL CW_SOKOL_HASH)
    message(FATAL_ERROR "Sokol dependency checksum mismatch; remove the cached archive and retry.")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${CW_SOKOL_ARCHIVE}"
    WORKING_DIRECTORY "${CW_DEPENDENCY_DIR}" RESULT_VARIABLE CW_SOKOL_EXTRACT_RESULT)
if(NOT CW_SOKOL_EXTRACT_RESULT EQUAL 0)
    message(FATAL_ERROR "Sokol dependency extraction failed.")
endif()
foreach(CW_SOKOL_FILE IN LISTS CW_SOKOL_REQUIRED)
    if(NOT EXISTS "${CW_SOKOL}/${CW_SOKOL_FILE}")
        message(FATAL_ERROR "Sokol dependency missing ${CW_SOKOL_FILE}")
    endif()
endforeach()
file(WRITE "${CW_SOKOL_MARKER}" "${CW_SOKOL_HASH}")
