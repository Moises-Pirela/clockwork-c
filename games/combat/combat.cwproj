cwproject 1
name combat
# the shared library the editor and player load (platform suffix added)
module build/combat_game
# sources compiled into the module and into exported games
source combat_game.c
scenes scenes
main_scene scenes/arena.cwscene
# rendering settings (render2d tunables, edited in the editor's settings panel)
render render.cfg
# the asset manifest (the editor's asset browser maintains it)
assets assets.cwassets
# the player's window
window 1280 800
title Clockwork combat
# the interface's reference resolution and how it scales to the window (expand|shrink|width|height|pixels)
ui 1280 720 expand
